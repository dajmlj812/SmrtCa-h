# ── PostgreSQL ───────────────────────────────────────────────
# Used by docker-compose AND the server. Copy this file to .env.
POSTGRES_USER=smrtcash
POSTGRES_PASSWORD=change_me_in_real_use
POSTGRES_DB=smrtcash
POSTGRES_PORT=5432

# Connection string the server uses.
# Host is "localhost" when the server runs on your machine (dev),
# and "db" when the server itself runs as a container (Phase 5).
DATABASE_URL=postgres://smrtcash:change_me_in_real_use@localhost:5432/smrtcash

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth & security (Phase 5) ────────────────────────────────
# Secret used to sign the session cookie. Required for sessions to survive
# a server restart. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When unset, the server generates an ephemeral one and every restart
# logs you out — acceptable for dev, not for a deployed instance.
SESSION_SECRET=

# Set to 1 when serving behind HTTPS (e.g. Caddy reverse-proxy). Adds the
# Secure flag to the session cookie so it can't leak over plain HTTP.
COOKIE_SECURE=0

# 32-byte AES-256-GCM key for at-rest attachment encryption. Generate the
# same way as SESSION_SECRET. When unset, new uploads are written to disk
# in plaintext (the pre-Phase-5 behavior). LOSING THIS KEY makes existing
# encrypted attachments unrecoverable — store it out of band.
ATTACHMENT_ENCRYPTION_KEY=

# ── AI normalization (pluggable provider) ────────────────────
# Options:
#   rules   — deterministic, zero-config baseline (no external calls)
#   claude  — Anthropic Claude API (requires ANTHROPIC_API_KEY)
#   ollama  — local model via Ollama (requires OLLAMA_BASE_URL)
#   none    — normalization disabled (transactions stay 'pending')
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Attachments (Phase 3) ────────────────────────────────────
# Filesystem path where receipts/attachments are stored. Defaults to
# <repo>/data/attachments. Mount a volume here in Docker (Phase 5).
# ATTACHMENTS_DIR=
# Aggregate request-size cap (bytes) across ALL files in a single upload.
# Per-file is already capped at 25 MB by @fastify/multipart; this guards
# the worst case (10 × 25 MB = 250 MB). Default 100 MB.
# ATTACHMENTS_MAX_REQUEST_BYTES=104857600
