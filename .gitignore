# Dependencies
node_modules/

# Build output
dist/
build/

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
e2e/storage-state.json

# Environment / secrets
.env
.env.local
*.local
# Belt-and-suspenders on top of .env so ad-hoc scratch files that
# look like credential notes can't be swept in by `git add -A`.
# Prompted by an actual incident on 0.15.2 — a Stripe.txt scratch
# file at the repo root with a live secret key got committed.
Stripe.txt
*-keys.txt
*-secrets.txt
*-notes.txt
keys/
secrets/

# Local data
uploads/
data/
*.sqlite

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code personal overrides (keep .claude/settings.json shareable)
.claude/settings.local.json

# Never commit real financial data
samples/*.CSV
samples/*.csv
samples/*.xlsx
samples/*.xls
!samples/.gitkeep
